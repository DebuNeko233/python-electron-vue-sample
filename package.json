{
  "name": "python-electron-vue-sample",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:combined": "node scripts/combined.mjs",
    "dev:frontend": "node scripts/ensure-electron.mjs && electron-vite dev",
    "dev:backend": "node scripts/python.mjs run",
    "setup": "node scripts/python.mjs setup",
    "python:use": "node scripts/python.mjs use",
    "python:info": "node scripts/python.mjs info",
    "python:list": "node scripts/python.mjs list",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test:backend": "node scripts/python.mjs test",
    "build": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "electron:setup": "node scripts/ensure-electron.mjs"
  },
  "dependencies": {
    "vue": "^3.5.44",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "Portable Electron + Vue + FastAPI starter with uv-managed Python"
}
